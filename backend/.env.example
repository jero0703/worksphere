# Database Configuration
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/worksphere_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=worksphere_db

# Security & JWT Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Application Workday Rules
WORK_DAY_HOURS=8.0
HALF_DAY_HOURS=4.0
